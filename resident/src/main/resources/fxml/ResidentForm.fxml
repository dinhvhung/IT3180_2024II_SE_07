<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<GridPane
        fx:controller="com.example.resident.ResidentFormController"
        xmlns:fx="http://javafx.com/fxml"
        hgap="10"
        vgap="10"
>
    <padding>
        <Insets top="10" right="10" bottom="10" left="10"/>
    </padding>

    <Label text="Họ tên:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
    <TextField fx:id="fullNameField" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

    <Label text="Email:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
    <TextField fx:id="emailField" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

    <Label text="Số điện thoại:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
    <TextField fx:id="phoneField" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

    <Label text="Căn hộ:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
    <TextField fx:id="apartmentNumberField" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

    <Button
            text="Lưu"
            onAction="#onSave"
            GridPane.rowIndex="4"
            GridPane.columnIndex="1"
            GridPane.halignment="RIGHT"
    />
</GridPane>