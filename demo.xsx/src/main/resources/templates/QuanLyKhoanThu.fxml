<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.controller.FeeControllerFX">
    <children>
        <VBox spacing="10" alignment="CENTER" prefWidth="600" prefHeight="400">
            <Label text="Quản lý Khoản Thu" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
            
            <HBox spacing="10">
                <Label text="Danh mục:"/>
                <TextField fx:id="categoryField"/>
                <Label text="Loại thu:"/>
                <ComboBox fx:id="feeTypeBox"/>
                <Button text="Tìm kiếm" onAction="#onSearch"/>
            </HBox>
            
            <TableView fx:id="feeTable">
                <columns>
                    <TableColumn text="ID" fx:id="idColumn"/>
                    <TableColumn text="Mô tả" fx:id="descriptionColumn"/>
                    <TableColumn text="Số tiền" fx:id="amountColumn"/>
                    <TableColumn text="Danh mục" fx:id="categoryColumn"/>
                </columns>
            </TableView>
            
            <HBox spacing="10">
                <Button text="Thêm"/>
                <Button text="Sửa"/>
                <Button text="Xóa"/>
                <Button text="Đánh dấu đã thanh toán"/>
                <Button text="Xác nhận thanh toán"/>
            </HBox>
        </VBox>
    </children>
</AnchorPane>
