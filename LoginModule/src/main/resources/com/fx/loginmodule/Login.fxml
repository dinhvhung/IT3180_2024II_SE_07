      <VBox id="login-view" layoutX="23.0" layoutY="144.0" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="290.0" prefWidth="600.0" styleClass="login-view" stylesheets="@application.css">
        <children>
          <HBox style="-fx-border-style: solid;" styleClass="login-title">
            <children>
              <Label styleClass="header" text="ĐĂNG NHẬP" />
            </children>
          </HBox>
          <VBox styleClass="login-body">
            <children>
