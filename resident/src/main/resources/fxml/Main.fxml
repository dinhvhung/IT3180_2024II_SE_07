<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.resident.MainController">

    <center>
        <VBox alignment="CENTER" spacing="20">
            <padding>
                <Insets top="30" right="30" bottom="30" left="30"/>
            </padding>
            <Label text="HỆ THỐNG QUẢN LÝ CƯ DÂN" style="-fx-font-size: 20px;"/>
            <Button text="Quản lý cư dân" onAction="#handleResidentButton" prefWidth="200"/>
            <Button text="Thoát" onAction="#handleExitButton" prefWidth="200"/>
        </VBox>
    </center>
</BorderPane>
